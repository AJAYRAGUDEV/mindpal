# Copy this file to .env and fill in your real key.
# .env is git-ignored and must NEVER be committed or bundled into the app.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# The model to call. VERIFY THIS NAME against the current model list before
# your first run — Google renames and retires models, and a stale name gives
# a 404 that looks like a broken key.
GEMINI_MODEL=gemini-3.6-flash

# Where this gateway listens.
PORT=8787

# Which origin the Flutter app is served from. Flutter web picks a random
# port each run; use `flutter run -d chrome --web-port=5000` to pin it.
# Use * only while developing locally.
ALLOWED_ORIGIN=*

# Safety rails for the free tier.
MAX_REQUESTS_PER_MINUTE=20
REQUEST_TIMEOUT_MS=15000

# Newer Gemini models spend tokens "thinking" before answering, from the same
# budget as the reply. If answers come back empty, uncomment this to turn
# thinking off. Leave it commented to let the model decide.
# GEMINI_THINKING_BUDGET=0
